#!/bin/bash
# Wrapper to run commands with the full infrastructure PATH
# This allows access to tools like grep, sed, uv, python, etc. that are not in safe_bin

if [ -z "$_INFRA_PATH" ]; then
  echo "Error: _INFRA_PATH not set (must be run from kid shell)" >&2
  exit 1
fi

if [ "$1" = "--print-path" ]; then
  echo "$_INFRA_PATH"
  exit 0
fi

# Restore full PATH temporarily
export PATH="$_INFRA_PATH"

# Run command
exec "$@"
